# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (free tier at mongodb.com/cloud/atlas)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/wealth_dashboard?retryWrites=true&w=majority&appName=Cluster0"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET="generate-with-openssl-rand-hex-32"
# Set to your production URL on Vercel (leave blank on Vercel — auto-detected)
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create at: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"

# ── Encryption ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="32-byte-hex-key-for-aes-256-encryption"

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# Set to true to bypass auth and use mock data (development only)
DEMO_MODE="false"

# ── Optional / Phase 4 ────────────────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY="your-alpha-vantage-key"
PYTHON_ANALYTICS_URL="http://localhost:8000"
