# MongoDB Atlas connection string (free tier at mongodb.com/cloud/atlas)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/wealth_dashboard?retryWrites=true&w=majority"
NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"
ENCRYPTION_KEY="32-byte-hex-key-for-aes-256-encryption"
ALPHA_VANTAGE_API_KEY="your-key-here"
PYTHON_ANALYTICS_URL="http://localhost:8000"
